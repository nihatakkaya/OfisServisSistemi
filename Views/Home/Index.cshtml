            gap: 10px;
        }

        .stok-kontroller {
            justify-content: space-between;
            width: 100%;
        }

        .modal-kutu {
            max-height: calc(100vh - 24px);
            overflow-y: auto;
            padding: 20px;
            width: calc(100vw - 24px);
        }

        #toast-container {
            bottom: 10px;
            left: 10px;
            right: 10px;
        }

        .toast-box {
            box-sizing: border-box;
            width: 100%;
        }
    }

    @@media (max-width: 420px) {
        .header-buttons {
            grid-template-columns: 1fr;
        }

        .oda-siparis-sayisi,
        .oda-bekleyen-sayisi,
        .sure-sayaci,
        .miktar-badge {
            font-size: 0.75rem;
        }

        .bilet-aksiyon {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid" style="max-width: 1600px;">

    <div class="header-bar">
        <div class="kat-info">
            <img src="/img/logo.png" class="kat-logo" alt="Logo" />
            <div class="kat-detay">
                <div class="kat-baslik">@(ViewBag.KatAdi ?? "Yönetim Paneli")</div>
                <div class="kat-alt-baslik">Görevli Mutfak & Hizmet Ekranı</div>
            </div>
        </div>
        <div class="header-buttons">
            <a href="/Home/Gecmis" class="btn-ozel">📋 Geçmiş Siparişler</a>
            <a href="/Account/Logout" class="btn-ozel btn-cikis">⏻ Çıkış</a>
        </div>
    </div>

    <audio id="sesDosyasi" src="/sounds/bildirim.mp3" preload="auto"></audio>
    <div id="toast-container"></div>

    <div class="ana-pano">

        <div class="pano-kolon kolon-cay">
            <div class="kolon-baslik"><span>ÇAY OCAĞI SİPARİŞLERİ</span></div>
            <div class="havuz-alan">
                @if (!cayOcagiTalepler.Any())
                {
                    <div class="bos-durum"></div>
                }
                else
                {
                    var cayGrupIndex = 0;
                    foreach (var odaGrubu in cayOcagiOdaGruplari)
                    {
                        string grupId = $"cay-oda-grup-{cayGrupIndex++}";

                        <div class="oda-akordiyon" id="kapsayici-@grupId">
                            <button type="button" class="oda-akordiyon-baslik" onclick="toggleOdaGrubu('@grupId')" aria-expanded="false" aria-controls="@grupId">
                                <span class="oda-akordiyon-sol">
                                    <span class="oda-akordiyon-ok" id="ok-@grupId">▶</span>
                                    <span class="oda-akordiyon-oda">ODA @odaGrubu.GercekOdaAdi</span>
                                </span>
                                <span class="oda-akordiyon-ozet">
                                    <span class="oda-siparis-sayisi">@odaGrubu.Talepler.Count sipariş</span>
                                    @if (odaGrubu.BekleyenSayisi > 0)
                                    {
                                        <span class="oda-bekleyen-sayisi">@odaGrubu.BekleyenSayisi bekliyor</span>
                                    }
                                </span>
                            </button>
                            <div class="oda-akordiyon-icerik" id="@grupId">
                                @foreach (var talep in odaGrubu.Talepler)
                                {
                                    string ikon = GetUrunIkon(talep.IslemTuru);

                                    <div class="siparis-bilet" id="satir-@talep.Id">
                                        <div class="bilet-detay">
                                            <div class="bilet-satir1">
                                                <div class="urun-adi">
                                                    @if (ikon.StartsWith("http"))
                                                    {
                                                        <img src="@ikon" class="dinamik-ikon" />
                                                    }
                                                    else
                                                    {
                                                        <span>@ikon</span>
                                                    }
                                                    @talep.IslemTuru
                                                </div>
                                                <span class="miktar-badge">x@(talep.Miktar)</span>
                                                <span class="sure-sayaci" data-satir-id="satir-@talep.Id" data-durum="@talep.Durum" data-tarih="@talep.OlusturulmaTarihi.ToString("yyyy-MM-dd HH:mm:ss")">...</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(talep.Aciklama) && talep.Aciklama != "-")
                                            {
                                                <div class="bilet-satir2"><span class="not-alani">Not: @talep.Aciklama</span></div>
                                            }
                                        </div>
                                        <div class="bilet-aksiyon">
                                            @if (talep.Durum == "Bekliyor")
                                            {
                                                <button class="btn-iptal" onclick="iptalModalAc(@talep.Id)">✖ İptal</button>
                                                <button class="btn-teslim" onclick="teslimEt(@talep.Id)">✓ Teslim Et</button>
                                            }
                                            else
                                            {
                                                <span class="badge-bekliyor">Onay Bekleniyor</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="pano-kolon kolon-hizmet">
            <div class="kolon-baslik"><span>HİZMET TALEPLERİ</span></div>
            <div class="havuz-alan">
                @if (!hizmetTalepler.Any())
                {
                    <div class="bos-durum"></div>
                }
                else
                {
                    var hizmetGrupIndex = 0;
                    foreach (var odaGrubu in hizmetOdaGruplari)
                    {
                        string grupId = $"hizmet-oda-grup-{hizmetGrupIndex++}";

                        <div class="oda-akordiyon" id="kapsayici-@grupId">
                            <button type="button" class="oda-akordiyon-baslik" onclick="toggleOdaGrubu('@grupId')" aria-expanded="false" aria-controls="@grupId">
                                <span class="oda-akordiyon-sol">
                                    <span class="oda-akordiyon-ok" id="ok-@grupId">▶</span>
                                    <span class="oda-akordiyon-oda">ODA @odaGrubu.GercekOdaAdi</span>
                                </span>
                                <span class="oda-akordiyon-ozet">
                                    <span class="oda-siparis-sayisi">@odaGrubu.Talepler.Count talep</span>
                                    @if (odaGrubu.BekleyenSayisi > 0)
                                    {
                                        <span class="oda-bekleyen-sayisi">@odaGrubu.BekleyenSayisi bekliyor</span>
                                    }
                                </span>
                            </button>
                            <div class="oda-akordiyon-icerik" id="@grupId">
                                @foreach (var talep in odaGrubu.Talepler)
                                {
                                    string ikon = talep.IslemTuru == "Temizlik" ? "🧹" : "🗑️";

                                    <div class="siparis-bilet" id="satir-@talep.Id">
                                        <div class="bilet-detay">
                                            <div class="bilet-satir1">
                                                <div class="urun-adi"><span>@ikon</span> @talep.IslemTuru</div>
                                                <span class="sure-sayaci" data-satir-id="satir-@talep.Id" data-durum="@talep.Durum" data-tarih="@talep.OlusturulmaTarihi.ToString("yyyy-MM-dd HH:mm:ss")">...</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(talep.Aciklama) && talep.Aciklama != "-")
                                            {
                                                <div class="bilet-satir2"><span class="not-alani">Not: @talep.Aciklama</span></div>
                                            }
                                        </div>
                                        <div class="bilet-aksiyon">
                                            @if (talep.Durum == "Bekliyor")
                                            {
                                                <button class="btn-iptal" onclick="iptalModalAc(@talep.Id)">✖ İptal</button>
                                                <button class="btn-teslim" onclick="teslimEt(@talep.Id)">✓ Tamamla</button>
                                            }
                                            else
                                            {
                                                <span class="badge-bekliyor">Onay Bekleniyor</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="pano-kolon kolon-stok">
            <div class="kolon-baslik" style="cursor: pointer;" onclick="toggleStok()">
                <span style="display:flex; align-items:center; gap:8px;">
                    <span id="stokOkIcon">▶</span> STOK
                </span>
                <button class="btn-yeni-ekle" onclick="urunEkleModalAc(event)">➕ Ekle</button>
            </div>

            <div class="havuz-alan" id="stokIcerikKutusu" style="gap: 12px; display: none; min-height: auto;">
                @if (!Model.Urunler.Any())
                {
                    <div class="bos-durum" style="padding: 20px; color: #adb5bd; font-weight: 600; text-align: center;">Henüz ürün eklenmemiş.</div>
                }
                else
                {
                    foreach (var urun in Model.Urunler)
                    {
                        string sIkon = GetUrunIkon(urun.Ad);
                        <div class="stok-satir">
                            <div class="stok-isim">
                                @if (sIkon.StartsWith("http"))
                                {
                                    <img src="@sIkon" class="stok-ikon" />
                                }
                                else
                                {
                                    <span>@sIkon</span>
                                }
                                @urun.Ad
                            </div>
                            <div class="stok-kontroller">
                                @if (urun.Miktar.HasValue)
                                {
                                    <div class="stok-arttir-azalt">
                                        <button class="stok-btn" onclick="stokGuncelle(@urun.Id, -1)">-</button>
                                        <div class="stok-deger">@urun.Miktar</div>
                                        <button class="stok-btn" onclick="stokGuncelle(@urun.Id, 1)">+</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="sinirsiz-badge">Sınırsız</span>
                                }
                                <button class="btn-stok-sil" onclick="urunSil(@urun.Id)" title="Sil">✖</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>

<div class="modal-overlay" id="urunEkleModal">
    <div class="modal-kutu">
        <div class="modal-baslik">📦 Yeni Ürün Ekle</div>
        <p class="modal-aciklama">Çay ocağı menüsüne yeni bir ürün ekleyin. Adet/sayı belirtmek istemiyorsanız miktarı boş bırakın (Sınırsız olarak eklenir).</p>
        <form method="post" action="/Home/UrunEkle">
            <input type="text" name="ad" class="modal-input" placeholder="Ürün Adı (Örn: Türk Kahvesi, Kola)" required />
            <input type="number" name="miktar" class="modal-input" placeholder="Miktar / Stok (İsteğe Bağlı)" min="1" />
            <div class="modal-butonlar">
                <button type="button" class="btn-vazgec" onclick="urunEkleModalKapat()">İptal</button>
                <button type="submit" class="btn-kaydet">Ürünü Ekle</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="iptalModal">
    <div class="modal-kutu">
        <div class="modal-baslik uyari">⚠️ Siparişi İptal Et</div>
        <p class="modal-aciklama">Bu siparişi reddetmek üzeresiniz. Dilerseniz siparişi veren kişiye iptal nedenini bildiren bir not bırakabilirsiniz.</p>
        <input type="hidden" id="iptalEdilecekTalepId" />
        <textarea id="iptalNotuInput" class="modal-textarea" rows="3" placeholder="Örn: Kusura bakmayın, çayımız tükenmiştir..."></textarea>
        <div class="modal-butonlar">
            <button class="btn-vazgec" onclick="iptalModalKapat()">Vazgeç</button>
            <button class="btn-kaydet kirmizi" onclick="siparisReddet()">İptal Et</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/ofisHub").withAutomaticReconnect().build();
    connection.start().catch(err => console.error(err));
    connection.on("SayfaGuncelle", function () { location.reload(); });

    connection.on("TalepAlindi", function (odaAdi, tur, aciklama) {
        var audio = document.getElementById("sesDosyasi");
        audio.play().catch(e => console.log(e));
        showToast(odaAdi, tur, aciklama);
        setTimeout(() => location.reload(), 1500);
    });

    function showToast(odaAdi, tur, aciklama) {
        var container = document.getElementById("toast-container");
        var html = `<div class="toast-box"><div>🔔</div><div><h5 style="margin:0;color:#003fa1;font-weight:bold;font-size:1.1rem;">ODA ${odaAdi}</h5><p style="margin:3px 0 0 0;font-weight:600;font-size:0.9rem;">${tur} İstedi</p></div></div>`;
        container.insertAdjacentHTML('beforeend', html);
    }

    function toggleOdaGrubu(grupId) {
        var icerik = document.getElementById(grupId);
        var kapsayici = document.getElementById('kapsayici-' + grupId);
        var ok = document.getElementById('ok-' + grupId);
        if (!icerik || !kapsayici) return;

        var acikMi = kapsayici.classList.toggle('acik');
        if (ok) ok.innerText = acikMi ? '▼' : '▶';

        var baslik = kapsayici.querySelector('.oda-akordiyon-baslik');
        if (baslik) baslik.setAttribute('aria-expanded', acikMi ? 'true' : 'false');
    }

    function siparisSatiriniGizle(id) {
        var satir = document.getElementById('satir-' + id);
        if (!satir) return;

        var grupIcerik = satir.closest('.oda-akordiyon-icerik');
        satir.style.display = 'none';

        if (!grupIcerik) return;

        var gorunenSiparisVar = Array.from(grupIcerik.querySelectorAll('.siparis-bilet'))
            .some(function(item) { return item.style.display !== 'none'; });

        if (!gorunenSiparisVar) {
            var kapsayici = grupIcerik.closest('.oda-akordiyon');
            if (kapsayici) kapsayici.style.display = 'none';
        }
    }

    function teslimEt(id) { fetch('/Home/AdminTeslimEtti?id=' + id, { method: 'POST' }).then(res => { if(res.ok) siparisSatiriniGizle(id); }); }
    function stokGuncelle(id, degisim) { fetch(`/Home/UrunMiktarGuncelle?id=${id}&degisim=${degisim}`, { method: 'POST' }).then(res => { if(res.ok) location.reload(); }); }
    function urunSil(id) { if(!confirm("Bu ürünü menüden kaldırmak istediğinize emin misiniz?")) return; fetch(`/Home/UrunSil?id=${id}`, { method: 'POST' }).then(res => { if(res.ok) location.reload(); }); }

    function toggleStok() {
        var kutu = document.getElementById("stokIcerikKutusu");
        var ok = document.getElementById("stokOkIcon");
        if (kutu.style.display === "none" || kutu.style.display === "") {
            kutu.style.display = "flex";
            ok.innerText = "▼";
        } else {
            kutu.style.display = "none";
            ok.innerText = "▶";
        }
    }

    function urunEkleModalAc(event) {
        if(event) event.stopPropagation();
        document.getElementById('urunEkleModal').style.display = 'flex';
    }

    function urunEkleModalKapat() { document.getElementById('urunEkleModal').style.display = 'none'; }

    function iptalModalAc(id) { document.getElementById('iptalEdilecekTalepId').value = id; document.getElementById('iptalNotuInput').value = ""; document.getElementById('iptalModal').style.display = 'flex'; }
    function iptalModalKapat() { document.getElementById('iptalModal').style.display = 'none'; }

    function siparisReddet() {
        var id = document.getElementById('iptalEdilecekTalepId').value;
        var not = document.getElementById('iptalNotuInput').value;
        fetch(`/Home/AdminReddetti?id=${id}&iptalNotu=${encodeURIComponent(not)}`, { method: 'POST' })
            .then(res => { if(res.ok) { iptalModalKapat(); siparisSatiriniGizle(id); } });
    }

    window.onclick = function(event) {
        if (event.target == document.getElementById('iptalModal')) iptalModalKapat();
        if (event.target == document.getElementById('urunEkleModal')) urunEkleModalKapat();
    }

    function sureGuncelle() {
        document.querySelectorAll('.sure-sayaci').forEach(function(el) {
            var tarihStr = el.getAttribute('data-tarih');
            var durum = el.getAttribute('data-durum');
            var satirId = el.getAttribute('data-satir-id');
            var satir = document.getElementById(satirId);

            if (durum !== 'Bekliyor') {
                el.innerText = "";
                if (satir) satir.classList.remove('kritik');
                return;
            }

            var farkDk = Math.floor((new Date() - new Date(tarihStr)) / 60000);

            if (farkDk < 1) { el.innerText = "Yeni"; }
            else if (farkDk < 10) { el.innerText = farkDk + " dk"; if(satir) satir.classList.remove('kritik'); }
            else { el.innerText = "⚠️ " + farkDk + " dk!"; if(satir) satir.classList.add('kritik'); }
        });
    }
    setInterval(sureGuncelle, 10000);
    document.addEventListener("DOMContentLoaded", sureGuncelle);
</script>

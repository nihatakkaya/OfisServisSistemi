@model OfisServisSistemi.ViewModels.KatDurumModel
@{
    ViewData["Title"] = "Personel - SUBU OYS";

    var hizmetTurleri = new List<string> { "Temizlik", "Çöp Alımı", "Çöp" };
    var cayOcagiTalepler = Model.AktifTalepler.Where(t => !hizmetTurleri.Contains(t.IslemTuru)).OrderBy(t => t.OlusturulmaTarihi).ToList();
    var hizmetTalepler = Model.AktifTalepler.Where(t => hizmetTurleri.Contains(t.IslemTuru)).OrderBy(t => t.OlusturulmaTarihi).ToList();

    var odaSozlugu = Model.Odalar.ToDictionary(
        o => o.KullaniciAdi,
        o => !string.IsNullOrEmpty(o.OdaNumarasi) ? o.OdaNumarasi : o.KullaniciAdi
    );

    var cayOcagiOdaGruplari = cayOcagiTalepler
        .GroupBy(t => t.OdaAdi)
        .Select(g => new
        {
            OdaAdi = g.Key,
            GercekOdaAdi = odaSozlugu.ContainsKey(g.Key) ? odaSozlugu[g.Key] : g.Key,
            Talepler = g.OrderBy(t => t.OlusturulmaTarihi).ToList(),
            BekleyenSayisi = g.Count(t => t.Durum == "Bekliyor")
        })
        .OrderBy(g => g.GercekOdaAdi)
        .ToList();

    var hizmetOdaGruplari = hizmetTalepler
        .GroupBy(t => t.OdaAdi)
        .Select(g => new
        {
            OdaAdi = g.Key,
            GercekOdaAdi = odaSozlugu.ContainsKey(g.Key) ? odaSozlugu[g.Key] : g.Key,
            Talepler = g.OrderBy(t => t.OlusturulmaTarihi).ToList(),
            BekleyenSayisi = g.Count(t => t.Durum == "Bekliyor")
        })
        .OrderBy(g => g.GercekOdaAdi)
        .ToList();

    string GetUrunIkon(string ad)
    {
        if (string.IsNullOrWhiteSpace(ad)) return "https://cdn-icons-png.flaticon.com/512/5164/5164023.png";

        string k = ad.ToLower(new System.Globalization.CultureInfo("tr-TR"))
                     .Replace("ı", "i").Replace("ü", "u").Replace("ö", "o")
                     .Replace("ş", "s").Replace("ç", "c").Replace("ğ", "g");

        if (k.Contains("cay") || k.Contains("oralet") || k.Contains("kusburnu") || k.Contains("ihlamur"))
            return "https://cdn-icons-png.flaticon.com/512/3504/3504837.png";

        if (k.Contains(" su") || k == "su")
            return "https://cdn-icons-png.flaticon.com/512/824/824239.png";

        if (k.Contains("soda") || k.Contains("maden") || k.Contains("kola") || k.Contains("fanta") || k.Contains("sprite") || k.Contains("ayran") || k.Contains("gazoz") || k.Contains("ice") || k.Contains("limonata"))
            return "https://cdn-icons-png.flaticon.com/512/659/659385.png";

        if (k.Contains("kahve") || k.Contains("nescafe") || k.Contains("espresso") || k.Contains("latte") || k.Contains("mocha") || k.Contains("macchiato"))
            return "https://cdn-icons-png.flaticon.com/512/590/590749.png";

        if (k.Contains("biskuvi") || k.Contains("kek") || k.Contains("cikolata") || k.Contains("kurabiye") || k.Contains("gofret") || k.Contains("cips"))
            return "🍪";
        if (k.Contains("seker")) return "🍬";
        if (k.Contains("temiz")) return "🧹";
        if (k.Contains("cop")) return "🗑️";

        return "https://cdn-icons-png.flaticon.com/512/5164/5164023.png";
    }
}


@{
    ViewData["Title"] = "Yetkisiz Erişim - SUBU OYS";
}

<style>
    :root {
        --renk-mavi: #1f4785;
        --renk-yesil: #229856;
        --renk-gri: #6b6e75;
    }

    .yetki-kutu {
        max-width: 560px;
        margin: 70px auto;
        padding: 28px;
        border: 1px solid #e5e8ef;
        border-left: 5px solid var(--renk-mavi);
        background: #fff;
        box-shadow: 0 8px 24px rgba(31, 71, 133, 0.08);
    }

    .yetki-baslik {
        color: var(--renk-mavi);
        font-weight: 800;
        margin-bottom: 10px;
    }

    .yetki-metin {
        color: var(--renk-gri);
        margin-bottom: 22px;
    }

    .btn-geri {
        display: inline-block;
        padding: 10px 18px;
        background: var(--renk-yesil);
        color: #fff;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
    }

    .btn-geri:hover {
        color: #fff;
        background: #1b7f47;
    }
</style>

<div class="yetki-kutu">
    <h2 class="yetki-baslik">Yetkisiz Erişim</h2>
    <p class="yetki-metin">Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz.</p>
    <a class="btn-geri" href="/">Ana Sayfaya Dön</a>
</div>

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - SUBU OYS</title>
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <style>
        /* --- KURUMSAL RENK PALETİ --- */
        :root {
            --renk-ana-mavi: #003fa1;
            --renk-teal: #00887a;
            --renk-yesil: #1bac50;
            --renk-gri: #6b6e75;
        }

        body {
            /* Arka Plan */
            background: url('/img/arkaplan.jpg') no-repeat center center fixed;
            background-size: cover;
            background-color: #eef2f6; 
            font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

           
            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.4); 
                z-index: -1;
                backdrop-filter: blur(3px); 
            }

        /* --- GİRİŞ KARTI --- */
        .login-card {
            background: rgba(255, 255, 255, 0.96); 
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 420px;
            overflow: hidden;
            position: relative;
            border-top: 6px solid var(--renk-ana-mavi); /* Üst Kurumsal Çizgi */
        }

        .login-header {
            padding: 40px 30px 10px 30px;
            text-align: center;
            background: transparent; 
        }

        .logo-img {
            height: 90px;
            margin-bottom: 15px;
        }

        .baslik {
            color: var(--renk-ana-mavi);
            font-weight: 800;
            font-size: 1.6rem;
            margin: 0;
            letter-spacing: -0.5px;
        }

        .alt-baslik {
            color: var(--renk-gri);
            font-size: 0.9rem;
            font-weight: 600;
            margin-top: 5px;
        }

        .login-body {
            padding: 30px 40px 50px 40px;
        }

        /* FORM ELEMANLARI */
        .form-label {
            font-weight: 700;
            color: #444;
            font-size: 0.9rem;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            padding: 14px;
            border-radius: 8px;
            border: 2px solid #e1e5eb;
            background-color: #f8f9fa;
            font-size: 1rem;
            transition: 0.3s;
        }

            .form-control:focus {
                border-color: var(--renk-teal); 
                background-color: #fff;
                box-shadow: 0 0 0 4px rgba(0, 136, 122, 0.1);
                outline: none;
            }

        /* BUTON */
        .btn-giris {
            background-color: var(--renk-yesil); 
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 1.1rem;
            color: white;
            width: 100%;
            margin-top: 25px;
            cursor: pointer;
            transition: 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(27, 172, 80, 0.3);
        }

            .btn-giris:hover {
                background-color: #159145;
                transform: translateY(-2px);
            }

        .footer-text {
            text-align: center;
            margin-top: 20px;
            font-size: 0.8rem;
            color: #aaa;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <img src="/img/logo.png" class="logo-img" alt="Ofis Logo" />
            <h1 class="baslik">Sakarya Uygulamalı Bilimler Üniversitesi</h1>
            <div class="alt-baslik">Personel ve Yönetim Girişi</div>
        </div>

        <div class="login-body">
            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger text-center p-2 mb-3 small fw-bold" style="border-radius: 8px;">
                    @ViewBag.Hata
                </div>
            }

            <form action="/Account/Login" method="post">
                <div class="mb-3">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input type="text" name="username" class="form-control" placeholder="Kullanıcı Adı" required />
                </div>

                <div class="mb-2">
                    <label class="form-label">Şifre</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••" required />
                </div>

                <button type="submit" class="btn-giris">Giriş Yap</button>
            </form>

            <div class="footer-text">
                &copy; Copyright Sakarya Uygulamalı Bilimler Üniversitesi 2019
            </div>
        </div>
    </div>

</body>
</html>
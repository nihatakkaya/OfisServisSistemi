@model OfisServisSistemi.Models.Kantin
@{
    ViewData["Title"] = Model.Ad + " Üyeleri";
    var binalar = ViewBag.Binalar as List<OfisServisSistemi.Models.Bina> ?? new List<OfisServisSistemi.Models.Bina>();
    var aidatYetkileri = ViewBag.AidatYetkileri as List<OfisServisSistemi.Models.AidatSorumlusuYetki> ?? new List<OfisServisSistemi.Models.AidatSorumlusuYetki>();
    var uyeGruplari = ViewBag.UyeGruplari as List<OfisServisSistemi.Models.KantinUyeGrup> ?? new List<OfisServisSistemi.Models.KantinUyeGrup>();
    var binaUyeGruplari = uyeGruplari.Where(g => !g.OdaBilgisiYok).GroupBy(g => g.BinaAdi).OrderBy(g => g.Key).ToList();
    var odaBilgisiOlmayanGrup = uyeGruplari.FirstOrDefault(g => g.OdaBilgisiYok);
}

<style>
    :root {
        --renk-ana-mavi: #003fa1;
        --renk-yesil: #1bac50;
        --renk-gri: #6b6e75;
        --renk-beyaz: #ffffff;
        --renk-zemin: #f4f6f9;
        --renk-teal: #00887a;
    }

    body {
        background-color: var(--renk-zemin);
        font-family: 'Segoe UI', sans-serif;
    }

    .ana-konteyner {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .header-bar {
        background: var(--renk-beyaz);
        border-radius: 12px;
        padding: 25px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #e1e5eb;
        margin-bottom: 30px;
        border-left: 6px solid var(--renk-ana-mavi);
    }

    .baslik {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--renk-ana-mavi);
        margin: 0;
    }

    .btn-geri {
        background: #f8f9fa;
        border: 1px solid #dfe1e5;
        color: var(--renk-gri);
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: bold;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-geri:hover {
            background: var(--renk-ana-mavi);
            color: white;
            border-color: var(--renk-ana-mavi);
        }

    .toplu-ekle-karti {
        background: #eef4ff;
        border: 1px solid #cce0ff;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .toplu-ekle-baslik {
        font-weight: 800;
        color: var(--renk-ana-mavi);
        margin-bottom: 15px;
    }

    .yetki-karti {
        background: #fff;
        border: 1px solid #e1e5eb;
        border-left: 6px solid var(--renk-yesil);
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .yetki-baslik {
        font-weight: 800;
        color: var(--renk-yesil);
        margin-bottom: 15px;
    }

    .kapsam-secim-listesi {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 8px;
    }

    .kapsam-grup {
        background: #fff;
        border: 1px solid #e1e5eb;
        border-radius: 8px;
        overflow: hidden;
    }

        .kapsam-grup[open] {
            border-color: #cce0ff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }

    .kapsam-grup-baslik {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px 16px;
        background: #f8f9fa;
        color: var(--renk-ana-mavi);
        cursor: pointer;
        list-style: none;
        font-weight: 800;
    }

        .kapsam-grup-baslik::-webkit-details-marker {
            display: none;
        }

    .kapsam-bina-adi {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .kapsam-kat-sayisi {
        color: var(--renk-gri);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .kapsam-grup-govde {
        padding: 14px 16px 16px;
    }

    .kapsam-checkbox {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        font-weight: 700;
        color: #2c3e50;
        cursor: pointer;
    }

        .kapsam-checkbox input {
            width: 17px;
            height: 17px;
            accent-color: var(--renk-ana-mavi);
        }

    .kat-secimleri {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 12px;
        padding: 12px 0 0 24px;
        border-top: 1px solid #eef1f5;
    }

        .kat-secimleri .kapsam-checkbox {
            font-size: 0.9rem;
            color: var(--renk-gri);
        }

    .custom-table {
        width: 100%;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
    }

        .custom-table th {
            background: #f8f9fa;
            padding: 15px;
            color: var(--renk-ana-mavi);
            font-weight: bold;
            border-bottom: 2px solid #e1e5eb;
        }

        .custom-table td {
            padding: 15px;
            border-bottom: 1px solid #f1f3f5;
            vertical-align: middle;
            font-weight: 600;
        }

    .uye-gruplari {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .bina-grup {
        background: var(--renk-beyaz);
        border: 1px solid #e1e5eb;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
    }

        .bina-grup[open] {
            border-color: #cce0ff;
        }

    .bina-grup-baslik,
    .kat-grup-baslik {
        padding: 16px 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: #f8f9fa;
        color: var(--renk-ana-mavi);
        font-weight: 800;
        list-style: none;
    }

    .bina-grup-baslik {
        background: #f8f9fa;
        color: var(--renk-ana-mavi);
    }

    .kat-grup-baslik {
        background: #fff;
        color: #2c3e50;
        border-top: 1px solid #eef1f5;
        padding-left: 34px;
    }

        .bina-grup-baslik::-webkit-details-marker,
        .kat-grup-baslik::-webkit-details-marker {
            display: none;
        }

    .uye-grup-isim {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .uye-grup-bina {
        font-size: 1rem;
    }

    .uye-grup-kat {
        color: var(--renk-gri);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .uye-sayisi {
        background: #eef4ff;
        border: 1px solid #cce0ff;
        color: var(--renk-ana-mavi);
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .kat-gruplari,
    .uye-grup-icerik {
        padding: 0;
    }

    .kat-grup {
        border-top: 1px solid #eef1f5;
    }

        .kat-grup[open] .kat-grup-baslik {
            background: #f7fbff;
        }

    .oda-bilgi {
        color: var(--renk-gri);
        font-size: 0.9rem;
    }
</style>

<div class="ana-konteyner">
    <div class="header-bar">
        <div>
            <h1 class="baslik">🏪 @Model.Ad</h1>
            <div style="color: var(--renk-gri); font-weight: 600; font-size: 0.9rem; margin-top: 5px;">Kantine Bağlı Personeller ve Odalar</div>
        </div>
        <a href="/Admin/Kantinler" class="btn-geri">← Kantinlere Dön</a>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success fw-bold">✅ @TempData["Basari"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger fw-bold">⚠️ @TempData["Hata"]</div>
    }

    <div class="yetki-karti">
        <h5 class="yetki-baslik">Aidat Sorumlusu Yetkilendirme</h5>
        <form action="/Admin/AidatSorumlusuYetkiEkle" method="post" class="row g-3 mb-4">
            <input type="hidden" name="kantinId" value="@Model.Id" />
            <div class="col-md-4">
                <label class="small fw-bold text-muted mb-1">Kullanıcı Adı</label>
                <input type="text" name="kullaniciAdi" class="form-control" style="padding:12px; font-weight:600;" placeholder="Veritabanındaki kullanıcı adı" required />
            </div>
            <div class="col-md-8 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100" style="padding:12px; font-weight:bold; background:var(--renk-yesil);">Seçili Kapsamlara Yetki Ver</button>
            </div>
            <div class="col-12">
                <label class="small fw-bold text-muted mb-1">Sorumluluk Kapsamları</label>
                <div class="kapsam-secim-listesi">
                    @foreach (var bina in binalar)
                    {
                        <details class="kapsam-grup">
                            <summary class="kapsam-grup-baslik">
                                <span class="kapsam-bina-adi">
                                    <span>@bina.Ad</span>
                                    <span class="kapsam-kat-sayisi">@bina.Katlar.Count kat</span>
                                </span>
                                <span class="uye-sayisi">Katları Aç</span>
                            </summary>
                            <div class="kapsam-grup-govde">
                                <label class="kapsam-checkbox">
                                    <input type="checkbox" name="kapsamlar" value="bina:@bina.Id" />
                                    <span>Tüm binayı sorumluluk kapsamına ekle</span>
                                </label>

                                <div class="kat-secimleri">
                                    @foreach (var kat in bina.Katlar.OrderBy(k => k.Ad))
                                    {
                                        <label class="kapsam-checkbox">
                                            <input type="checkbox" name="kapsamlar" value="kat:@kat.Id" />
                                            <span>@kat.Ad</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </details>
                    }
                </div>
            </div>
        </form>

        <table class="custom-table">
            <thead>
                <tr>
                    <th>Aidat Sorumlusu</th>
                    <th>Kapsam</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var yetki in aidatYetkileri)
                {
                    <tr>
                        <td>@yetki.Kullanici.KullaniciAdi</td>
                        <td>
                            @if (yetki.Kat != null)
                            {
                                <span class="badge bg-light text-dark border">Kat: @yetki.Kat.Ad</span>
                            }
                            else if (yetki.Bina != null)
                            {
                                <span class="badge bg-light text-dark border">Tüm Bina: @yetki.Bina.Ad</span>
                            }
                        </td>
                        <td class="text-end">
                            <form action="/Admin/AidatSorumlusuYetkiSil" method="post" onsubmit="return confirm('Bu aidat sorumlusu yetkisini kaldırmak istediğinize emin misiniz?');">
                                <input type="hidden" name="id" value="@yetki.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Yetkiyi Kaldır</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!aidatYetkileri.Any())
                {
                    <tr><td colspan="3" class="text-center py-4 text-muted fw-bold">Bu kantin için henüz aidat sorumlusu tanımlı değil.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="toplu-ekle-karti">
        <h5 class="toplu-ekle-baslik">Hızlı / Toplu Personel Ekleme</h5>
        <p class="text-muted small mb-3">Bir kattaki tüm personelleri tek tuşla bu kantine (aidat havuzuna) bağlayabilirsiniz.</p>

        <form action="/Admin/KantinKullaniciTopluEkle" method="post" class="row g-3">
            <input type="hidden" name="kantinId" value="@Model.Id" />
            <div class="col-md-9">
                <select name="katId" class="form-select" style="padding:12px; font-weight:600;" required>
                    <option value="">-- Bina ve Kat Seçiniz --</option>
                    @foreach (var bina in binalar)
                    {
                        <optgroup label="🏢 @bina.Ad">
                            @foreach (var kat in bina.Katlar)
                            {
                                <option value="@kat.Id">📍 @kat.Ad</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100" style="padding:12px; font-weight:bold; background:var(--renk-ana-mavi);">Tümünü Ekle</button>
            </div>
        </form>
    </div>

    <div class="uye-gruplari">
        @foreach (var binaGrubu in binaUyeGruplari)
        {
            <details class="bina-grup">
                <summary class="bina-grup-baslik">
                    <span class="uye-grup-isim">
                        <span class="uye-grup-bina">@binaGrubu.Key</span>
                        <span class="uye-grup-kat">@binaGrubu.Count() kat</span>
                    </span>
                    <span class="uye-sayisi">@binaGrubu.Sum(g => g.Uyeler.Count) kişi</span>
                </summary>
                <div class="kat-gruplari">
                    @foreach (var katGrubu in binaGrubu.OrderBy(g => g.KatAdi))
                    {
                        <details class="kat-grup">
                            <summary class="kat-grup-baslik">
                                <span class="uye-grup-isim">
                                    <span class="uye-grup-bina">@katGrubu.KatAdi</span>
                                    <span class="uye-grup-kat">@katGrubu.BinaAdi</span>
                                </span>
                                <span class="uye-sayisi">@katGrubu.Uyeler.Count kişi</span>
                            </summary>
                            <div class="uye-grup-icerik">
                                <table class="custom-table" style="box-shadow:none; border-radius:0;">
                                    <thead>
                                        <tr>
                                            <th>Kullanıcı / Oda Adı</th>
                                            <th>Rolü</th>
                                            <th class="text-end">İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var uye in katGrubu.Uyeler)
                                        {
                                            <tr>
                                                <td style="font-size: 1.1rem; color:#333;">
                                                    @uye.KullaniciAdi
                                                    @if (!string.IsNullOrWhiteSpace(uye.OdaNumarasi))
                                                    {
                                                        <div class="oda-bilgi">Oda @uye.OdaNumarasi</div>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">@uye.Rol</span>
                                                    @if (uye.AidatYoneticisiMi)
                                                    {
                                                        <span class="badge" style="background:#e6f4ea; color:var(--renk-yesil); border:1px solid #b7e4c7;">Aidat Yetkisi Var</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <form action="/Admin/KantinKullaniciSil" method="post" onsubmit="return confirm('Bu kişiyi kantinden çıkarmak istediğinize emin misiniz?');">
                                                        <input type="hidden" name="id" value="@uye.UyelikId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Kantinden Çıkar</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
            </details>
        }

        @if (odaBilgisiOlmayanGrup != null)
        {
            <details class="bina-grup">
                <summary class="bina-grup-baslik">
                    <span class="uye-grup-isim">
                        <span class="uye-grup-bina">@odaBilgisiOlmayanGrup.BinaAdi</span>
                        <span class="uye-grup-kat">@odaBilgisiOlmayanGrup.KatAdi</span>
                    </span>
                    <span class="uye-sayisi">@odaBilgisiOlmayanGrup.Uyeler.Count kişi</span>
                </summary>
                <div class="uye-grup-icerik">
                    <table class="custom-table" style="box-shadow:none; border-radius:0;">
                        <thead>
                            <tr>
                                <th>Kullanıcı / Oda Adı</th>
                                <th>Rolü</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var uye in odaBilgisiOlmayanGrup.Uyeler)
                            {
                                <tr>
                                    <td style="font-size: 1.1rem; color:#333;">@uye.KullaniciAdi</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@uye.Rol</span>
                                        @if (uye.AidatYoneticisiMi)
                                        {
                                            <span class="badge" style="background:#e6f4ea; color:var(--renk-yesil); border:1px solid #b7e4c7;">Aidat Yetkisi Var</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form action="/Admin/KantinKullaniciSil" method="post" onsubmit="return confirm('Bu kişiyi kantinden çıkarmak istediğinize emin misiniz?');">
                                            <input type="hidden" name="id" value="@uye.UyelikId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Kantinden Çıkar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }

        @if (!uyeGruplari.Any())
        {
            <div class="custom-table text-center py-5 text-muted fw-bold">Bu kantine henüz kimse eklenmemiş. Yukarıdan toplu ekleme yapabilirsiniz.</div>
        }
    </div>
</div>

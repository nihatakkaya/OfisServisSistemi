@model OfisServisSistemi.Models.Kat
@{
    var aidatYonetimiMi = ViewBag.AidatYonetimiMi == true;
    ViewData["Title"] = Model.Ad + " - Kullanıcılar";
}

<style>
    /* --- KURUMSAL RENK PALETİ --- */
    :root {
        --renk-ana-mavi: #003fa1;
        --renk-teal: #00887a;
        --renk-yesil: #1bac50;
        --renk-gri: #6b6e75;
        --renk-beyaz: #ffffff;
        --renk-zemin: #f4f6f9;
        --renk-acikmavi: #eef4ff;
    }

    body {
        background-color: var(--renk-zemin);
        font-family: 'Segoe UI', sans-serif;
        color: #333;
    }

    .ana-konteyner {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    /* HEADER */
    .header-bar {
        background: var(--renk-beyaz);
        border-radius: 16px;
        padding: 25px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border: 1px solid #e1e5eb;
        margin-bottom: 30px;
        border-left: 8px solid var(--renk-ana-mavi);
    }

    .baslik-buyuk {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--renk-ana-mavi);
        margin: 0;
    }

    .baslik-alt {
        color: var(--renk-gri);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .btn-geri {
        background: #f8f9fa;
        border: 1px solid #dfe1e5;
        color: var(--renk-gri);
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-geri:hover {
            background: var(--renk-ana-mavi);
            color: white;
            border-color: var(--renk-ana-mavi);
        }

    /* EKLEME FORMU */
    .ekleme-karti {
        background: var(--renk-beyaz);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #e1e5eb;
        margin-bottom: 30px;
    }

    .form-baslik {
        font-weight: 700;
        color: #444;
        margin-bottom: 15px;
        border-bottom: 2px solid #f0f2f5;
        padding-bottom: 10px;
    }

    .input-ozel {
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #dfe1e5;
        width: 100%;
        outline: none;
        transition: 0.3s;
    }

        .input-ozel:focus {
            border-color: var(--renk-teal);
            box-shadow: 0 0 0 3px rgba(0, 136, 122, 0.1);
        }

    .btn-kaydet {
        background-color: var(--renk-teal);
        color: white;
        border: none;
        padding: 12px;
        border-radius: 6px;
        font-weight: 700;
        width: 100%;
        cursor: pointer;
    }

        .btn-kaydet:hover {
            background-color: #006d62;
        }

    /* --- YENİ: ARAMA LİSTESİ TASARIMI --- */
    .autocomplete-container {
        position: relative;
    }

    .autocomplete-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        background: white;
        border: 1px solid #dfe1e5;
        border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        max-height: 200px;
        overflow-y: auto;
        margin-top: 5px;
        padding: 0;
        list-style: none;
        display: none;
    }

        .autocomplete-list li {
            padding: 10px 15px;
            cursor: pointer;
            border-bottom: 1px solid #f1f3f5;
            color: #333;
            font-weight: 600;
        }

            .autocomplete-list li:hover {
                background: var(--renk-acikmavi);
                color: var(--renk-ana-mavi);
            }

            .autocomplete-list li:last-child {
                border-bottom: none;
            }

    /* TABLO */
    .table-container {
        background: var(--renk-beyaz);
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #e1e5eb;
        overflow: hidden;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table th {
            background-color: #f8f9fa;
            padding: 15px 25px;
            text-align: left;
            font-weight: 700;
            color: var(--renk-ana-mavi);
            border-bottom: 2px solid #eef0f2;
        }

        .custom-table td {
            padding: 15px 25px;
            border-bottom: 1px solid #f1f3f5;
            color: #333;
            vertical-align: middle;
        }

    .badge-rol {
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .rol-oda {
        background: #eef4ff;
        color: var(--renk-ana-mavi);
    }

    .rol-gorevli {
        background: #fff3cd;
        color: #856404;
    }

    .rol-aidat {
        background: #e6f4ea;
        color: var(--renk-yesil);
    }

    .badge-oda {
        background: #e9ecef;
        color: #495057;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }
</style>

<div class="ana-konteyner">
    <div class="header-bar">
        <div>
            <h1 class="baslik-buyuk">@Model.Ad</h1>
            <div class="baslik-alt">@Model.Bina.Ad / Kullanıcı Yönetimi</div>
        </div>
        <a href="@(aidatYonetimiMi ? $"/Home/AidatBinaDetay/{Model.BinaId}" : $"/Admin/BinaDetay/{Model.BinaId}")" class="btn-geri">← Katlara Dön</a>
    </div>

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger" style="background:#fff5f5; color:#dc3545; border:1px solid #ffcdd2; padding:15px; border-radius:8px; font-weight:700; margin-bottom:20px;">
            ⚠️ @TempData["Hata"]
        </div>
    }
    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success" style="background:#e6f4ea; color:#1bac50; border:1px solid #b7e4c7; padding:15px; border-radius:8px; font-weight:700; margin-bottom:20px;">
            ✅ @TempData["Basari"]
        </div>
    }

    <div class="ekleme-karti">
        <h5 class="form-baslik">➕ Yeni Kullanıcı / Yetki Ekle</h5>
        <form action="@(aidatYonetimiMi ? "/Home/AidatKullaniciEkle" : "/Admin/KullaniciEkle")" method="post" class="row g-3">
            <input type="hidden" name="katId" value="@Model.Id" />

            <div class="col-md-4 autocomplete-container">
                <label class="small fw-bold text-muted mb-1">Kullanıcı Adı</label>
                <input type="text" name="kullaniciAdi" id="kullaniciAdiInput" class="input-ozel" required autocomplete="off" placeholder="Aramak için yazın..." />
                <ul id="kullaniciListesi" class="autocomplete-list"></ul>
            </div>

            <div class="col-md-3">
                <label class="small fw-bold text-muted mb-1">Rol / Yetki</label>
                <select name="rol" id="ekleRolSelect" class="input-ozel">
                    <option value="Oda">Oda (Sipariş Veren)</option>
                    <option value="KatGorevlisi">Kat Görevlisi</option>
                </select>
            </div>

            <div class="col-md-3" id="ekleOdaNumarasiAlani">
                <label class="small fw-bold text-muted mb-1">Oda Numarası</label>
                <input type="text" name="odaNumarasi" class="input-ozel" placeholder="Örn: 101" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn-kaydet">Ekle</button>
            </div>
        </form>
    </div>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Kullanıcı Adı</th>
                    <th>Rol</th>
                    <th>Oda Numarası</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Kullanicilar)
                {
                    <tr>
                        <td class="fw-bold" style="font-size: 1.1rem;">@user.KullaniciAdi</td>
                        <td>
                            @if (user.Rol == "Oda")
                            {
                                <span class="badge-rol rol-oda">Oda (Sipariş Veren)</span>
                            }
                            else
                            {
                                <span class="badge-rol rol-gorevli">Kat Görevlisi</span>
                            }
                            @if (user.AidatYoneticisiMi)
                            {
                                <span class="badge-rol rol-aidat ms-1">Aidat Sorumlusu</span>
                            }
                        </td>
                        <td>
                            @if (user.Rol == "Oda" && !string.IsNullOrEmpty(user.OdaNumarasi))
                            {
                                <span class="badge-oda">@user.OdaNumarasi</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-warning text-dark fw-bold me-2" data-bs-toggle="modal" data-bs-target="#userEditModal" onclick="userDuzenle(@user.Id, '@user.KullaniciAdi', '@user.Rol', '@user.OdaNumarasi')">Düzenle</button>
                            <form action="@(aidatYonetimiMi ? "/Home/AidatKullaniciSil" : "/Admin/KullaniciSil")" method="post" style="display:inline;" onsubmit="return confirm('Silmek istiyor musunuz?');">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Kullanicilar.Count == 0)
                {
                    <tr><td colspan="4" class="text-center py-4 text-muted">Bu katta henüz kullanıcı yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="userEditModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Kullanıcı Düzenle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form action="@(aidatYonetimiMi ? "/Home/AidatKullaniciGuncelle" : "/Admin/KullaniciGuncelle")" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editUserId" />

                    <div class="mb-3">
                        <label class="fw-bold small">Kullanıcı Adı</label>
                        <input type="text" name="kullaniciAdi" id="editUserAd" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold small">Rol</label>
                        <select name="rol" id="editUserRole" class="form-control">
                            <option value="Oda">Oda (Sipariş Veren)</option>
                            <option value="KatGorevlisi">Kat Görevlisi</option>
                        </select>
                    </div>

                    <div class="mb-3" id="editOdaNumarasiAlani">
                        <label class="fw-bold small">Oda Numarası</label>
                        <input type="text" name="odaNumarasi" id="editUserOda" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Güncelle</button></div>
            </form>
        </div>
    </div>
</div>

<script>
    // --- YENİ EKLENEN: CANLI ARAMA SCRİPTİ ---
    const input = document.getElementById('kullaniciAdiInput');
    const list = document.getElementById('kullaniciListesi');

    input.addEventListener('input', function() {
        const q = this.value.trim();
        if (q.length < 1) {
            list.style.display = 'none';
            return;
        }

        const aramaUrl = '@(aidatYonetimiMi ? "/Home/AidatKullaniciAra" : "/Admin/KullaniciAra")';
        fetch(aramaUrl + '?q=' + encodeURIComponent(q))
            .then(res => res.json())
            .then(data => {
                list.innerHTML = ''; // Eski listeyi temizle
                if (data.length > 0) {
                    data.forEach(ad => {
                        const li = document.createElement('li');
                        li.innerText = ad;
                        li.onclick = function() {
                            input.value = ad;
                            list.style.display = 'none';
                        };
                        list.appendChild(li);
                    });
                    list.style.display = 'block';
                } else {
                    const li = document.createElement('li');
                    li.innerText = 'Kayıt bulunamadı...';
                    li.style.color = '#dc3545';
                    li.style.pointerEvents = 'none'; // Tıklanmayı engelle
                    list.appendChild(li);
                    list.style.display = 'block';
                }
            });
    });

    // Dışarı tıklayınca listeyi gizle
    document.addEventListener('click', function(e) {
        if (e.target !== input) list.style.display = 'none';
    });


    // Ekleme formunda rol değişince Oda Numarası kutusunu göster/gizle
    document.getElementById('ekleRolSelect').addEventListener('change', function() {
        var alan = document.getElementById('ekleOdaNumarasiAlani');
        if(this.value === 'Oda') { alan.style.display = 'block'; }
        else { alan.style.display = 'none'; }
    });

    // Düzenleme formunda rol değişince Oda Numarası kutusunu göster/gizle
    document.getElementById('editUserRole').addEventListener('change', function() {
        var alan = document.getElementById('editOdaNumarasiAlani');
        if(this.value === 'Oda') { alan.style.display = 'block'; }
        else { alan.style.display = 'none'; }
    });

    // Düzenleme butonuna basılınca modal'ı doldur
    function userDuzenle(id, ad, rol, oda) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserAd').value = ad;
        document.getElementById('editUserRole').value = rol;
        document.getElementById('editUserOda').value = oda !== '' ? oda : '';

        var alan = document.getElementById('editOdaNumarasiAlani');
        if(rol === 'Oda') { alan.style.display = 'block'; }
        else { alan.style.display = 'none'; }
    }
</script>
